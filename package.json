{
  "name": "pattern-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode github-pages",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:pages": "vite preview --mode github-pages --host 127.0.0.1 --port 4173 --strictPort",
    "publish:pages": "node scripts/publish-pages.mjs",
    "postinstall": "node scripts/copy-pyodide.mjs",
    "test": "python -m unittest discover -s tests -p \"test_*.py\" && python scripts/validate_content.py --check-review",
    "test:content": "python scripts/validate_content.py",
    "test:browser": "node tests/browser.mjs",
    "test:pages": "node tests/pages.mjs",
    "test:runtime": "node tests/runtime-browser.mjs",
    "test:visuals": "node tests/visualizations.mjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "pyodide": "^0.29.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
