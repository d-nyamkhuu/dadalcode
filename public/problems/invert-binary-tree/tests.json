[
  {
    "name": "Example: balanced tree",
    "input": {
      "root": [
        4,
        2,
        7,
        1,
        3,
        6,
        9
      ]
    },
    "expected": [
      4,
      7,
      2,
      9,
      6,
      3,
      1
    ]
  },
  {
    "name": "Example: three nodes",
    "input": {
      "root": [
        2,
        1,
        3
      ]
    },
    "expected": [
      2,
      3,
      1
    ]
  },
  {
    "name": "Empty",
    "input": {
      "root": []
    },
    "expected": []
  },
  {
    "name": "Single",
    "input": {
      "root": [
        1
      ]
    },
    "expected": [
      1
    ]
  },
  {
    "name": "Left child",
    "input": {
      "root": [
        1,
        2
      ]
    },
    "expected": [
      1,
      null,
      2
    ]
  },
  {
    "name": "Asymmetric",
    "input": {
      "root": [
        1,
        2,
        3,
        null,
        4
      ]
    },
    "expected": [
      1,
      3,
      2,
      null,
      null,
      4
    ]
  }
