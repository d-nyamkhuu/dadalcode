[
  {
    "name": "Sparse example",
    "input": {
      "root": [
        1,
        2,
        3,
        null,
        null,
        4,
        5
      ]
    },
    "expected": [
      1,
      2,
      3,
      null,
      null,
      4,
      5
    ]
  },
  {
    "name": "Empty tree",
    "input": {
      "root": []
    },
    "expected": []
  },
  {
    "name": "Negative root",
    "input": {
      "root": [
        -1
      ]
    },
    "expected": [
      -1
    ]
  },
  {
    "name": "Right-child shape",
    "input": {
      "root": [
        1,
        null,
        2
      ]
    },
    "expected": [
      1,
      null,
      2
    ]
  },
  {
    "name": "Left-child shape",
    "input": {
      "root": [
        1,
        2
      ]
    },
    "expected": [
      1,
      2
    ]
  },
  {
    "name": "Repeated and negative values",
    "input": {
      "root": [
        0,
        0,
        -2,
        null,
        3
      ]
    },
    "expected": [
      0,
      0,
      -2,
      null,
      3
    ]
  }
]
