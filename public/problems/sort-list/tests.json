      ]
    },
    "expected": [
      -1,
      0,
      3,
      4,
      5
    ]
  },
  {
    "name": "Empty",
    "input": {
      "head": []
    },
    "expected": []
  },
  {
    "name": "Singleton",
    "input": {
      "head": [
        2
      ]
    },
    "expected": [
      2
    ]
  },
  {
    "name": "Duplicate keys",
    "input": {
      "head": [
        3,
